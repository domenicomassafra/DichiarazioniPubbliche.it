{
  "schema_version": 1,
  "name": "evidence-sources-v1",
  "defaults": {
    "connect_timeout_seconds": 8,
    "read_timeout_seconds": 20,
    "max_response_bytes": 8388608,
    "cache_ttl_seconds": 3600,
    "redirect_limit": 4,
    "user_agent": "DichiarazioniPubbliche/0.1 evidence-retrieval (+DichiarazioniPubbliche.it)"
  },
  "sources": [
    {
      "id": "istat-sdmx",
      "publisher": "ISTAT",
      "evidence_class": "PRIMARY_OFFICIAL_STATISTICS",
      "authoritative": true,
      "allowed_hosts": ["esploradati.istat.it"],
      "allowed_path_prefixes": ["/SDMXWS/"],
      "allowed_methods": ["GET"],
      "base_url": "https://esploradati.istat.it/SDMXWS/rest/",
      "rate_limit": {"requests": 4, "window_seconds": 60},
      "cache_ttl_seconds": 21600,
      "accepted_content_types": [
        "application/json",
        "application/xml",
        "text/xml",
        "text/csv",
        "application/vnd.sdmx"
      ],
      "notes": "Keep below ISTAT's documented 5 queries/minute per-IP limit."
    },
    {
      "id": "istat-publications",
      "publisher": "ISTAT",
      "evidence_class": "PRIMARY_OFFICIAL_STATISTICS",
      "authoritative": true,
      "allowed_hosts": ["www.istat.it", "istat.it"],
      "allowed_path_prefixes": [
        "/comunicato-stampa/",
        "/produzione-editoriale/",
        "/statistiche-per-temi/"
      ],
      "allowed_methods": ["GET"],
      "base_url": "https://www.istat.it/",
      "rate_limit": {"requests": 12, "window_seconds": 60},
      "cache_ttl_seconds": 21600,
      "accepted_content_types": ["text/html", "application/pdf"]
    },
    {
      "id": "eurostat-api",
      "publisher": "Eurostat",
