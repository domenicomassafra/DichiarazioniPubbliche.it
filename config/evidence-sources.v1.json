      "allowed_methods": ["GET"],
      "base_url": "https://ec.europa.eu/eurostat/api/",
      "rate_limit": {"requests": 20, "window_seconds": 60},
      "cache_ttl_seconds": 21600,
      "accepted_content_types": [
        "application/json",
        "application/xml",
        "text/xml",
        "text/csv",
        "text/tab-separated-values",
        "application/vnd.sdmx"
      ]
    },
    {
