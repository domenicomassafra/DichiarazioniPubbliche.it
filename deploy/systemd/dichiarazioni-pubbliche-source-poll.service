[Unit]
Description=Dichiarazioni Pubbliche source registry poll
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=60s
WorkingDirectory=%h/src/DichiarazioniPubbliche.it
EnvironmentFile=-%h/.config/dichiarazioni-pubbliche/runtime.env
Environment=PYTHONPATH=poc
ExecStart=/usr/bin/python3 -m dichiarazioni_pubbliche.native_source_watch
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
