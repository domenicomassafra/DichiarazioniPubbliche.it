[Unit]
Description=Dichiarazioni Pubbliche source registry poll

[Service]
Type=oneshot
WorkingDirectory=%h/src/DichiarazioniPubbliche.it
EnvironmentFile=-%h/.config/dichiarazioni-pubbliche/runtime.env
Environment=PYTHONPATH=poc
ExecStart=/usr/bin/python3 -m dichiarazioni_pubbliche.scheduler_daemon
NoNewPrivileges=yes
PrivateTmp=yes
