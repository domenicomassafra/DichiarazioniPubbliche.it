[Unit]
Description=Dichiarazioni Pubbliche evening summary to the owner
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/DichiarazioniPubbliche.it
EnvironmentFile=-%h/.config/dichiarazioni-pubbliche/runtime.env
Environment=PYTHONPATH=poc
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m dichiarazioni_pubbliche.daily_machine --evening-summary --deliver --summary-file %h/.local/state/dichiarazioni-pubbliche/evening-summary.txt
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
