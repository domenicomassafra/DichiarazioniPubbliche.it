[Unit]
Description=Dichiarazioni Pubbliche processing queue worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/DichiarazioniPubbliche.it
EnvironmentFile=-%h/.config/dichiarazioni-pubbliche/runtime.env
EnvironmentFile=-%h/.config/dichiarazioni-pubbliche/claim-runtime.env
Environment=PYTHONPATH=poc
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m dichiarazioni_pubbliche.worker_daemon --max-jobs 5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/dichiarazioni-pubbliche %h/.local/state/dichiarazioni-pubbliche
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
