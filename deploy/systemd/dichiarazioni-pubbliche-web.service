[Unit]
Description=Dichiarazioni Pubbliche same-origin public web/API preview
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/dichiarazioni-pubbliche/host-release/current/code
ExecStart=/usr/bin/env PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=poc /usr/bin/python3 -m dichiarazioni_pubbliche.public_api --projection-path %h/.local/share/dichiarazioni-pubbliche/host-release/current/projection/index.json --static-dir %h/.local/share/dichiarazioni-pubbliche/host-release/current/static --host 127.0.0.1 --port 18090
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/.local/share/dichiarazioni-pubbliche/host-release
RestrictAddressFamilies=AF_UNIX AF_INET

[Install]
WantedBy=default.target
