[Unit]
Description=Dichiarazioni Pubbliche private runtime health digest

[Service]
Type=oneshot
WorkingDirectory=%h/src/DichiarazioniPubbliche.it
EnvironmentFile=-%h/.config/dichiarazioni-pubbliche/runtime.env
Environment=PYTHONPATH=poc
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m dichiarazioni_pubbliche.health_digest
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/dichiarazioni-pubbliche
RestrictAddressFamilies=AF_UNIX
