[Unit]
Description=Dichiarazioni Pubbliche daily full-source registry poll
After=network-online.target
Wants=network-online.target
OnFailure=hc-fail@%N.service
OnSuccess=hc-ok@%N.service

[Service]
Type=oneshot
WorkingDirectory=%h/src/DichiarazioniPubbliche.it
EnvironmentFile=-%h/.config/dichiarazioni-pubbliche/runtime.env
Environment=PYTHONPATH=poc
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=dichiarazioni-pubbliche/statement-inbox
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 -m dichiarazioni_pubbliche.scheduler_daemon --full-source --max-cost-usd-day 0 --max-cost-usd-source-day 0
ExecStart=/usr/bin/python3 -m dichiarazioni_pubbliche.statement_batch %S/dichiarazioni-pubbliche/statement-inbox
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
