[Unit]
Description=Dichiarazioni Pubbliche daily machine: sources to published statements with a verdict
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/DichiarazioniPubbliche.it
EnvironmentFile=-%h/.config/dichiarazioni-pubbliche/runtime.env
Environment=PYTHONPATH=poc
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# DP-638: one bounded run does discovery, capture, statements, verdict and the
# public projection export. The OmniRoute key is read through the secret CLI,
# never from a file in this unit.
ExecStart=/bin/bash -lc 'cd %h/src/DichiarazioniPubbliche.it && secret env OMNIROUTE_API_KEY -- python3 -m dichiarazioni_pubbliche.daily_machine --report %h/.local/state/dichiarazioni-pubbliche/daily-run.json && python3 -m dichiarazioni_pubbliche.daily_publication --projection %h/.local/share/dichiarazioni-pubbliche/public-projection/index.json'
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
