{
  "schema_version": "numeric-structured-providers-v1",
  "cases": [
    {
      "id": "istat-delta",
      "provider_family": "ISTAT",
      "kind": "numeric_delta",
      "rule": {
        "left_metric": "employment_rate_current",
        "right_metric": "employment_rate_previous",
        "left_reference_period": "2026-07",
        "right_reference_period": "2025-07",
        "value": 1.5,
        "tolerance": 0.01
      },
      "observations": [
        {
          "evidence_id": "istat:employment:2026-07",
          "metric": "employment_rate_current",
          "value_numeric": 63.5,
          "unit": "percent",
          "reference_period": "2026-07",
          "dimensions": {"geography": "IT", "population": "working_age"}
        },
        {
          "evidence_id": "istat:employment:2025-07",
          "metric": "employment_rate_previous",
          "value_numeric": 62.0,
          "unit": "percent",
          "reference_period": "2025-07",
          "dimensions": {"geography": "IT", "population": "working_age"}
        }
      ],
      "expected_observed": 1.5
    },
