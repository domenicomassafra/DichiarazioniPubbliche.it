---
import TraceRecord from "../../components/TraceRecord.astro";
import { collectPublicTraces, type PublicTrace } from "../../lib/relations";
import { loadPublicProjection } from "../../lib/projection";

export async function getStaticPaths() {
  const projection = await loadPublicProjection();
  return collectPublicTraces(projection).map((trace) => ({
    params: { id: trace.slug },
    props: { trace }
  }));
}

interface Props { trace: PublicTrace }
const { trace } = Astro.props;
---

<TraceRecord trace={trace} />
