---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchField from "../components/SearchField.astro";
import ClaimRow from "../components/ClaimRow.astro";
import MediaFeature from "../components/MediaFeature.astro";
import { loadPublicProjection } from "../lib/projection";

const projection = await loadPublicProjection();
const recent = [...projection.dossiers]
  .sort((a, b) => new Date(b.finding.published_at ?? 0).getTime() - new Date(a.finding.published_at ?? 0).getTime())
  .slice(0, 4);
const featuredContent = recent[0];
const hasPublicRecords = projection.dossiers.length > 0 || (projection.topics?.length ?? 0) > 0 || (projection.contents?.length ?? 0) > 0;
---

<BaseLayout title="Dichiarazioni Pubbliche" canonicalPath="/">
  <section class="shell home-hero home-hero-v4">
    <div class="hero-copy hero-copy-v4">
      <p class="eyebrow">Dichiarazioni Pubbliche</p>
      <h1 class="display-title">Le parole contano. Le fonti anche.</h1>
      <p class="lede">Un archivio per ritrovare le dichiarazioni pubbliche, leggere le fonti originali e capire come sono state verificate. Senza classifiche delle persone.</p>
    </div>
    {hasPublicRecords ? (
      <div class="hero-search hero-search-v4" aria-label="Ricerca principale">
        <strong>Cerca nell'archivio</strong>
        <SearchField placeholder="Cerca una dichiarazione, una persona o un tema…" />
        <p class="search-note">Solo risultati con una fonte e una revisione pubblicate. <a href="/esplora/">Esplora l'archivio →</a></p>
      </div>
    ) : (
      <aside class="hero-search hero-search-v4 home-launch-status" aria-labelledby="archivio-stato">
        <p class="eyebrow">Stato dell'archivio</p>
        <h2 id="archivio-stato">Nessuna dichiarazione ancora pubblicata.</h2>
        <p>Il sito è consultabile. Le schede compariranno solo dopo il controllo delle fonti, delle attribuzioni e delle verifiche.</p>
        <a class="text-link" href="/metodo/">Scopri come funziona <span aria-hidden="true">→</span></a>
      </aside>
    )}
  </section>

  {hasPublicRecords && <section class="shell page-section-tight home-recent">
    <div class="section-heading ruled-heading">
      <div class="section-heading-copy">
        <h2 class="section-title">Dichiarazioni recenti</h2>
        <p>Ogni scheda rimanda alle fonti pubblicate.</p>
      </div>
      <a class="text-link" href="/esplora/">Esplora tutto <span aria-hidden="true">→</span></a>
    </div>
    {recent.length > 0 ? (
      <div class="claim-list">
        {recent.map((dossier) => <ClaimRow dossier={dossier} showTopic={false} />)}
      </div>
    ) : (
      <div class="dp-utility-empty">
        <h2>Non ci sono ancora dichiarazioni pubblicate.</h2>
        <p>Puoi comunque consultare i contenuti già approvati in <a href="/esplora/">Esplora</a>.</p>
      </div>
    )}
  </section>}

  {featuredContent && (
    <section class="shell page-section-tight home-source">
      <div class="section-heading ruled-heading">
        <div class="section-heading-copy">
          <h2 class="section-title">Dentro la fonte</h2>
          <p>Dal testo alla sua fonte originale.</p>
        </div>
      </div>
      <MediaFeature
        title={featuredContent.source.title}
        description={`Da questa fonte pubblica proviene una dichiarazione attribuita a ${featuredContent.speaker.name}. Il record conserva il collegamento all'originale e le evidenze approvate.`}
        href={featuredContent.source.url}
        duration="Fonte originale"
      />
    </section>
  )}

  <section class="shell home-trust-path">
    <div>
      <div class="eyebrow">Prima le fonti</div>
      <h2>Come riconoscere una verifica controllabile.</h2>
      <p>Ogni scheda pubblicata deve permettere di risalire alle parole originali, vedere quali prove sono state usate e leggere eventuali correzioni. Il metodo è pubblico anche quando l'archivio è vuoto.</p>
    </div>
    <nav aria-label="Percorsi di fiducia">
      <a href="/metodo/">Come verifichiamo →</a>
      <a href="/progetto/">Il progetto →</a>
      <a href="/correzioni/">Correzioni e repliche →</a>
      <a href="/dati/">Dati pubblici e API →</a>
    </nav>
  </section>
</BaseLayout>
