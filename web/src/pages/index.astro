---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchField from "../components/SearchField.astro";
import ClaimRow from "../components/ClaimRow.astro";
import { loadPublicProjection } from "../lib/projection";
import { loadPublishedPeopleV3 } from "../lib/publishedPeopleV3";

const projection = await loadPublicProjection();
const peopleRelease = await loadPublishedPeopleV3();
const chronological = [...projection.dossiers]
  .sort((a, b) => new Date(b.finding.published_at ?? 0).getTime() - new Date(a.finding.published_at ?? 0).getTime());
const recent = chronological.slice(0, 4);
const featured = chronological.find((dossier) => dossier.finding.publication_status !== "RETRACTED");
const recentOthers = recent.filter((dossier) => dossier !== featured).slice(0, 3);
const hasPublicRecords = projection.dossiers.length > 0 ||
  (projection.topics?.length ?? 0) > 0 ||
  (projection.contents?.length ?? 0) > 0 ||
  (peopleRelease?.people.length ?? 0) > 0;

const explorePaths = [
  { label: "Dichiarazioni", href: "/esplora/?tipo=finding", description: "Leggi le formulazioni pubblicate, gli esiti e le evidenze." },
  { label: "Persone", href: "/esplora/?tipo=person", description: "Segui le dichiarazioni attribuite alle persone pubbliche." },
  { label: "Temi", href: "/esplora/?tipo=topic", description: "Esamina le dichiarazioni attraverso i loro argomenti." },
  { label: "Fonti", href: "/esplora/?tipo=content", description: "Risali ai contenuti originali e al contesto disponibile." },
];
---

<BaseLayout title="Dichiarazioni Pubbliche" canonicalPath="/">
  <div class="dp-home">
    <section class="shell home-hero home-hero-v4 atlas-hero dp-home-hero" aria-labelledby="home-title">
      <div class="hero-copy hero-copy-v4 dp-home-intro">
        <h1 id="home-title" class="display-title">Le parole restano.<em>Le fonti contano.</em></h1>
        <p class="lede">Cosa è stato detto, da chi e in quale contesto. Un archivio pubblico per ritrovare le dichiarazioni, leggere le verifiche e tornare alle fonti originali.</p>
        {hasPublicRecords ? (
          <div class="hero-search hero-search-v4 dp-home-search" aria-label="Ricerca principale">
            <strong>Cerca nell'archivio pubblico</strong>
            <SearchField placeholder="Una persona, una dichiarazione, un tema…" />
            <p class="search-note">I risultati provengono dai soli record approvati. <a href="/esplora/">Esplora il registro <span aria-hidden="true">↗</span></a></p>
          </div>
        ) : (
          <aside class="hero-search hero-search-v4 home-launch-status dp-home-empty" aria-labelledby="archivio-stato">
            <span class="dp-home-empty__marker" aria-hidden="true"></span>
            <div>
              <h2 id="archivio-stato">Nessuna dichiarazione ancora pubblicata.</h2>
              <p>L'archivio è in preparazione. La ricerca sarà disponibile con i primi record approvati; intanto puoi consultare il metodo e le regole di correzione.</p>
              <a class="text-link" href="/metodo/">Scopri come funziona <span aria-hidden="true">↗</span></a>
            </div>
          </aside>
        )}
      </div>
      <aside class="atlas-reading-path dp-home-path" aria-labelledby="atlas-reading-heading">
        <h2 id="atlas-reading-heading">Ogni affermazione ha un contesto.</h2>
        <p>Una scheda pubblicata conduce dalle parole alla loro documentazione, senza trasformare un esito in un giudizio sulla persona.</p>
        <ol>
          <li><span aria-hidden="true">01</span><span>La dichiarazione e la sua attribuzione.</span></li>
          <li><span aria-hidden="true">02</span><span>La fonte originale e la data.</span></li>
          <li><span aria-hidden="true">03</span><span>Le prove e i limiti della verifica.</span></li>
          <li><span aria-hidden="true">04</span><span>Le repliche, le revisioni e le correzioni.</span></li>
        </ol>
        <a class="text-link" href="/metodo/">Leggi il metodo <span aria-hidden="true">↗</span></a>
      </aside>
    </section>

    {featured && (
      <section class="shell dp-home-feature" aria-labelledby="home-feature-heading">
        <div class="dp-home-feature__intro">
          <h2 id="home-feature-heading">Dalle parole alle prove.</h2>
          <p>Una dichiarazione pubblicata conserva la formulazione normalizzata, il suo esito e il percorso verso la fonte.</p>
          <a class="text-link" href={featured.source.url} rel="noreferrer">Apri la fonte originale <span aria-hidden="true">↗</span></a>
        </div>
        <div class="dp-home-feature__record">
          <ClaimRow dossier={featured} showTopic={false} />
        </div>
      </section>
    )}

    {recentOthers.length > 0 && (
      <section class="shell page-section-tight home-recent dp-home-recent" aria-labelledby="home-recent-heading">
        <div class="section-heading ruled-heading">
          <div class="section-heading-copy">
            <h2 id="home-recent-heading" class="section-title">Nel registro, di recente</h2>
            <p>Solo dichiarazioni già pubblicate e consultabili.</p>
          </div>
          <a class="text-link" href="/esplora/?ordine=recent">Vedi tutte <span aria-hidden="true">↗</span></a>
        </div>
        <div class="claim-list">
          {recentOthers.map((dossier) => <ClaimRow dossier={dossier} showTopic={false} />)}
        </div>
      </section>
    )}

    <section class="shell home-trust-path dp-home-method" aria-labelledby="home-method-heading">
      <div>
        <h2 id="home-method-heading">Una verifica da leggere, non da prendere sulla parola.</h2>
        <p>Le conclusioni devono poter essere controllate: parole originali, attribuzione, prove disponibili e cambiamenti nel tempo. Il metodo resta pubblico anche quando non ci sono record.</p>
      </div>
      <nav aria-label="Trasparenza e metodo">
        <a href="/metodo/">Come funzionano le verifiche <span aria-hidden="true">↗</span></a>
        <a href="/correzioni/">Correzioni e repliche <span aria-hidden="true">↗</span></a>
        <a href="/dati/">Dati pubblici e API <span aria-hidden="true">↗</span></a>
      </nav>
    </section>

    <section class="shell dp-home-explore" aria-labelledby="home-explore-heading">
      <div class="dp-home-explore__heading">
        <h2 id="home-explore-heading">Da dove vuoi cominciare?</h2>
        <p>{hasPublicRecords ? "Scegli un percorso nel registro pubblico." : "Questi percorsi si popoleranno con i primi contenuti approvati."}</p>
      </div>
      <nav class="dp-home-explore__grid" aria-label="Esplora il registro">
        {explorePaths.map((item) => (
          <a href={item.href} class="dp-home-explore__item">
            <strong>{item.label}</strong>
            <span class="dp-home-explore__description">{item.description}</span>
            <span class="dp-home-explore__arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>
    </section>
  </div>
</BaseLayout>
