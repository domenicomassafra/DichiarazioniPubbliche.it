---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchField from "../components/SearchField.astro";
import ClaimRow from "../components/ClaimRow.astro";
import MediaFeature from "../components/MediaFeature.astro";
import { loadPublicProjection } from "../lib/projection";

const projection = await loadPublicProjection();
const recent = [...projection.dossiers]
  .sort((a, b) => new Date(b.finding.published_at ?? 0).getTime() - new Date(a.finding.published_at ?? 0).getTime())
  .slice(0, 4);
const featuredContent = recent[0];
---

<BaseLayout title="Dichiarazioni Pubbliche" canonicalPath="/">
  <section class="shell home-hero home-hero-v4">
    <div class="hero-copy hero-copy-v4">
      <p class="eyebrow">Registro pubblico delle dichiarazioni</p>
      <h1 class="display-title">La parola lascia una traccia.</h1>
      <p class="lede">Un registro consultabile di ciò che è stato detto in pubblico: parole, fonti, verifiche e cambiamenti nel tempo, senza punteggi alle persone.</p>
    </div>
    <div class="hero-search hero-search-v4" aria-label="Ricerca principale">
      <strong>Cerca nel registro</strong>
      <SearchField placeholder="Dichiarazione, persona, tema o contenuto…" />
      <p class="search-note">Cerca ciò che è già pubblicato nel record oppure <a href="/esplora/">esplora tutto →</a></p>
    </div>
  </section>

  <section class="shell page-section-tight home-recent">
    <div class="section-heading ruled-heading">
      <div class="section-heading-copy">
        <h2 class="section-title">Dichiarazioni recenti</h2>
        <p>Il record parte sempre dalle parole e dalla fonte.</p>
      </div>
      <a class="text-link" href="/esplora/">Esplora tutto <span aria-hidden="true">→</span></a>
    </div>
    {recent.length > 0 ? (
      <div class="claim-list">
        {recent.map((dossier) => <ClaimRow dossier={dossier} showTopic={false} />)}
      </div>
    ) : (
      <div class="dp-utility-empty">
        <h2>Nessuna dichiarazione pubblicata in questo snapshot.</h2>
        <p>La navigazione e il Metodo restano disponibili anche quando la projection non contiene record pubblicabili.</p>
      </div>
    )}
  </section>

  {featuredContent && (
    <section class="shell page-section-tight home-source">
      <div class="section-heading ruled-heading">
        <div class="section-heading-copy">
          <h2 class="section-title">Dentro la fonte</h2>
          <p>Un esempio del percorso che riporta il record al contenuto originale.</p>
        </div>
      </div>
      <MediaFeature
        title={featuredContent.source.title}
        description={`Da questa fonte pubblica proviene una dichiarazione attribuita a ${featuredContent.speaker.name}. Il record conserva il collegamento all'originale e le evidenze approvate.`}
        href={featuredContent.source.url}
        duration="Fonte originale"
      />
    </section>
  )}

  <section class="shell home-trust-path">
    <div>
      <div class="eyebrow">Come fidarsi del percorso</div>
      <h2>Non chiediamo di fidarti di un punteggio.</h2>
      <p>Apri la dichiarazione, torna alla fonte, leggi le evidenze e controlla come gestiamo limiti e correzioni.</p>
    </div>
    <nav aria-label="Percorsi di fiducia">
      <a href="/metodo/">Metodo →</a>
      <a href="/correzioni/">Correzioni →</a>
      <a href="/dati/">Dati &amp; API →</a>
    </nav>
  </section>
</BaseLayout>
