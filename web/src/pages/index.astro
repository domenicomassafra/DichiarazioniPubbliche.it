---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchField from "../components/SearchField.astro";
import ClaimRow from "../components/ClaimRow.astro";
import MediaFeature from "../components/MediaFeature.astro";
import { contentSlug } from "../lib/format";
import { loadPublicProjection } from "../lib/projection";

const projection = await loadPublicProjection();
const recent = [...projection.dossiers]
  .sort((a, b) => new Date(b.finding.published_at ?? 0).getTime() - new Date(a.finding.published_at ?? 0).getTime())
  .slice(0, 4);
const featuredContent = recent[0];
---

<BaseLayout title="Dichiarazioni Pubbliche">
  <section class="shell home-hero">
    <div class="hero-index" aria-hidden="true">01</div>
    <div class="hero-copy">
      <p class="eyebrow">Archivio pubblico verificabile</p>
      <h1 class="display-title">La parola lascia<br /> una traccia.</h1>
      <p class="lede">Dichiarazioni Pubbliche mette in relazione dichiarazioni, fonti e tempo. Non stabilisce chi sia affidabile: rende leggibile perché una verifica regge.</p>
      <a class="hero-action" href="/esplora/">Esplora il record <span aria-hidden="true">→</span></a>
    </div>
    <aside class="hero-search" aria-label="Ricerca principale">
      <p class="eyebrow">Parti da una dichiarazione</p>
      <SearchField placeholder="Cerca una dichiarazione, una persona, un tema…" />
      <p class="search-note">Ogni risultato conserva esito, fonti, data e percorso di revisione.</p>
    </aside>
  </section>

  <section class="shell page-section-tight">
    <div class="section-heading ruled-heading">
      <div class="section-number" aria-hidden="true">02</div>
      <div class="section-heading-copy">
        <h2 class="section-title">Ultime verifiche</h2>
        <p>Il margine dell’archivio. Le più recenti, in ordine di pubblicazione.</p>
      </div>
      <a class="text-link" href="/esplora/">Vedi tutte <span aria-hidden="true">→</span></a>
    </div>
    <div class="claim-list">
      {recent.map((dossier) => <ClaimRow dossier={dossier} />)}
    </div>
  </section>

  {featuredContent && (
    <section class="shell page-section-tight">
      <div class="section-heading ruled-heading">
        <div class="section-number" aria-hidden="true">03</div>
        <div class="section-heading-copy"><h2 class="section-title">Dentro la fonte</h2><p>Dal contenuto originale ai singoli momenti verificati.</p></div>
      </div>
      <MediaFeature title={featuredContent.source.title} description="Apri il ContentAudit per vedere i finding pubblicati legati allo stesso contenuto e alle loro posizioni nella fonte." href={`/contents/${contentSlug(featuredContent)}/`} duration="Fonte originale" />
    </section>
  )}

  <section class="shell page-section-tight home-manifesto">
    <div class="section-number" aria-hidden="true">04</div>
    <div class="home-paths">
      <a class="home-path" href="/esplora/">
        <span class="path-index">A</span>
        <strong>Il record</strong>
        <p>Dichiarazioni, esiti e fonti nello stesso indice. Nessun punteggio per le persone.</p>
      </a>
      <a class="home-path" href="/metodo/">
        <span class="path-index">B</span>
        <strong>Il metodo</strong>
        <p>Come Dichiarazioni Pubbliche separa evidenza, verifica, revisione e pubblicazione.</p>
      </a>
      <a class="home-path" href="/api/v1/openapi.json">
        <span class="path-index">C</span>
        <strong>Dati e API</strong>
        <p>Lo stesso record pubblico, in forma machine-readable e senza punteggi sulle persone.</p>
      </a>
    </div>
  </section>
</BaseLayout>
