---
import BaseLayout from "../layouts/BaseLayout.astro";
import UtilityDocument from "../components/UtilityDocument.astro";
import { dossierSlug, formatDate } from "../lib/format";
import { loadPublicProjection } from "../lib/projection";

const projection = await loadPublicProjection();
const entries = projection.dossiers
  .flatMap((dossier) => dossier.corrections.map((correction) => ({ dossier, correction })))
  .sort((a, b) => {
    const left = String(a.correction.created_at ?? a.dossier.finding.published_at ?? "");
    const right = String(b.correction.created_at ?? b.dossier.finding.published_at ?? "");
    return right.localeCompare(left);
  });
---

<BaseLayout title="Correzioni" description="Registro cronologico delle correzioni pubbliche collegate alle dichiarazioni." canonicalPath="/correzioni/">
  <UtilityDocument eyebrow="Correzioni" title="Una correzione non cancella la storia." lede="Qui trovi le correzioni rese pubbliche, in ordine cronologico, con un collegamento alla scheda interessata e alla sua storia. Le versioni cambiano, il percorso per verificarle rimane.">
    <p>Vuoi contestare una scheda? Consulta le <a href="/segnalazioni/">istruzioni per inviare una rettifica o una segnalazione privacy</a>. La richiesta è confermata soltanto quando il servizio di invio restituisce un identificativo.</p>
    {entries.length === 0 ? (
      <section class="dp-utility-empty" aria-labelledby="correzioni-vuote">
        <h2 id="correzioni-vuote">Nessuna correzione pubblicata.</h2>
        <p>Questo registro contiene soltanto correzioni già incluse nella proiezione pubblica. Non mostra richieste private, verifiche in corso o versioni sospese.</p>
        <p><a href="/metodo/#correzioni">Leggi come funzionano versioni, repliche e rettifiche</a>.</p>
      </section>
    ) : (
      <ol class="dp-correction-list" aria-label="Correzioni pubblicate, dalla più recente">
        {entries.map(({ dossier, correction }) => (
          <li class="dp-correction-item">
            <div class="dp-correction-item__date">{formatDate(String(correction.created_at ?? dossier.finding.published_at ?? ""))}</div>
            <div>
              <h2><a href={`/dichiarazioni/${dossierSlug(dossier)}/`}>{dossier.claim}</a></h2>
              <p class="dp-correction-item__meta">{dossier.speaker.name} · {dossier.source.title}</p>
              {correction.reason && <p>{String(correction.reason)}</p>}
              <p class="dp-correction-item__version"><a href={`/dichiarazioni/${dossierSlug(dossier)}/#storia`}>Apri la cronologia della dichiarazione</a></p>
            </div>
          </li>
        ))}
      </ol>
    )}
  </UtilityDocument>
</BaseLayout>
