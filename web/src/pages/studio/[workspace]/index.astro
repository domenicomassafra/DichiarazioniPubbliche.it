---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StudioWorkspaceClient from "../../../components/StudioWorkspaceClient";
import StudioReadOnlyWorkspace from "../../../components/StudioReadOnlyWorkspace";
import StudioWorkspaceFrame from "../../../components/StudioWorkspaceFrame.astro";
import { studioFixtures } from "../../../data/studio";
import {
  fixtureOptInEnabled,
  resolveStudioViewModel,
  type StudioWorkspaceKind,
} from "../../../lib/studioViewModel";

const workspaces: StudioWorkspaceKind[] = ["corpus", "inbox", "collections", "verify"];

export function getStaticPaths() {
  const allowFixture = import.meta.env.DEV || fixtureOptInEnabled(import.meta.env.DICHIARAZIONI_PUBBLICHE_STUDIO_FIXTURE_ONLY);
  if (!allowFixture) return [];
  const staticWorkspaces = ["corpus", "inbox", "collections", "verify"];
  return staticWorkspaces.map((workspace) => ({ params: { workspace } }));
}

const workspace = Astro.params.workspace as StudioWorkspaceKind;
if (!workspaces.includes(workspace)) throw new Error("STUDIO_WORKSPACE_INVALID");
const model = resolveStudioViewModel(studioFixtures[workspace], { allow_fixture: true });
if ("unavailable" in model) throw new Error("STUDIO_FIXTURE_BUILD_UNAVAILABLE");
---

<BaseLayout title={`Studio · ${model.title}`} studio>
  <StudioWorkspaceFrame model={model}>
    {(model.workspace === "corpus" || model.workspace === "inbox" || model.workspace === "collections") &&
      <StudioReadOnlyWorkspace model={model} client:load />}

    {model.workspace === "verify" && <StudioWorkspaceClient model={model} client:load />}
  </StudioWorkspaceFrame>
</BaseLayout>
