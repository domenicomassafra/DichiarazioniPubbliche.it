---
import DossierStatementV2 from "../../components/DossierStatementV2.astro";
import PublicPersonStatementV3 from "../../components/PublicPersonStatementV3.astro";
import { dossierSlug } from "../../lib/format";
import { loadPublicProjection } from "../../lib/projection";
import { loadPublishedPeopleV3 } from "../../lib/publishedPeopleV3";
import type { PublicDossier } from "../../lib/types";
import type { ApprovedPersonV3, ApprovedPersonV3Statement } from "../../lib/publicPersonV3";

export async function getStaticPaths() {
  const projection = await loadPublicProjection();
  const routes: Array<{params: {slug: string}; props: Props}> = projection.dossiers.map(dossier => ({
    params: { slug: dossierSlug(dossier) },
    props: { dossier },
  }));
  const seen = new Set(routes.map(item => item.params.slug));
  const released = await loadPublishedPeopleV3();
  for (const person of released?.people ?? []) {
    for (const statement of person.statements) {
      const slug = statement.statement_route.slice("/dichiarazioni/".length, -1);
      if (seen.has(slug)) throw new Error("DP438_PUBLIC_STATEMENT_ROUTE_COLLISION");
      seen.add(slug);
      routes.push({params:{slug},props:{person,statement}});
    }
  }
  return routes;
}

interface Props {
  dossier?: PublicDossier;
  person?: ApprovedPersonV3;
  statement?: ApprovedPersonV3Statement;
}
const { dossier, person, statement } = Astro.props;
---

{person && statement
  ? <PublicPersonStatementV3 person={person} statement={statement} />
  : dossier ? <DossierStatementV2 dossier={dossier} /> : null}
