---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SearchField from "../../../components/SearchField.astro";
import ClaimRow from "../../../components/ClaimRow.astro";
import { formatDate, speakerSlug } from "../../../lib/format";
import { loadPublicProjection } from "../../../lib/projection";
import type { PublicDossier } from "../../../lib/types";

export async function getStaticPaths() {
  const projection = await loadPublicProjection();
  const groups = new Map<string, PublicDossier[]>();
  for (const dossier of projection.dossiers) {
    const id = speakerSlug(dossier);
    groups.set(id, [...(groups.get(id) ?? []), dossier]);
  }
  return [...groups.entries()].map(([id, dossiers]) => ({ params: { id }, props: { dossiers } }));
}

interface Props { dossiers: PublicDossier[] }
const { dossiers } = Astro.props;
const speaker = dossiers[0].speaker;
const ordered = [...dossiers].sort((a, b) => {
  const ad = Date.parse(a.finding.published_at ?? a.source.published_at ?? "1970-01-01");
  const bd = Date.parse(b.finding.published_at ?? b.source.published_at ?? "1970-01-01");
  return bd - ad || a.finding_id.localeCompare(b.finding_id);
});
const roles = speaker.public_roles ?? [];
const sourceOptions = [...new Set(ordered.map((item) => item.source.title))].sort();
const typeOptions = [...new Set(ordered.map((item) => item.claim_type))].sort();
---

<BaseLayout title={speaker.name} description={`Record pubblico verificabile di ${speaker.name}.`} canonicalPath={`/record/person/${speakerSlug(dossiers[0])}/`}>
  <header class="record-header">
    <div class="shell record-header-grid">
      <div>
        <div class="eyebrow">Record pubblico · Persona</div>
        <h1 class="page-title">{speaker.name}</h1>
        {roles.length > 0 && (
          <div class="record-role" aria-label="Ruoli pubblici approvati">
            {roles.map((role) => (
              <div>
                <strong>{role.role}</strong>{role.organization_name ? ` · ${role.organization_name}` : ""}
                {(role.start_date || role.end_date) && <small> · {role.start_date ? formatDate(role.start_date) : "inizio non disponibile"}–{role.end_date ? formatDate(role.end_date) : "in corso"}</small>}
              </div>
            ))}
          </div>
        )}
        <p>Le valutazioni appartengono alle singole dichiarazioni. Dichiarazioni Pubbliche non assegna punteggi o classifiche alle persone.</p>
      </div>
      <SearchField action="/esplora/" name="q" placeholder="Cerca nel record pubblico" compact />
    </div>
  </header>

  <section class="shell page-section-tight">
    <form class="record-filters" data-record-filters>
      <label>Tipo di claim
        <select name="type">
          <option value="">Tutti</option>
          {typeOptions.map((value) => <option value={value}>{value.replaceAll("_", " ")}</option>)}
        </select>
      </label>
      <label>Fonte
        <select name="source">
          <option value="">Tutte</option>
          {sourceOptions.map((value) => <option value={value}>{value}</option>)}
        </select>
      </label>
      <label>Dal <input name="from" type="date" /></label>
      <label>Al <input name="to" type="date" /></label>
      <button type="reset">Azzera filtri</button>
      <span aria-live="polite" data-record-count>{ordered.length} verifiche pubbliche</span>
    </form>

    <div class="section-heading">
      <div class="section-heading-copy">
        <h2 class="section-title section-title-sm">Cronologia</h2>
        <p>Solo finding presenti nella proiezione pubblica approvata.</p>
      </div>
    </div>
    <div class="claim-list" data-record-list>
      {ordered.map((dossier) => (
        <div
          data-record-row
          data-type={dossier.claim_type}
          data-source={dossier.source.title}
          data-date={(dossier.finding.published_at ?? dossier.source.published_at ?? "").slice(0, 10)}
        ><ClaimRow dossier={dossier} /></div>
      ))}
    </div>
    <p data-record-empty hidden>Nessuna verifica pubblica corrisponde ai filtri. <a href="/esplora/">Esplora il record</a> o <a href="/metodo/">leggi il metodo</a>.</p>
  </section>

  <script is:inline>
    (() => {
      const form = document.querySelector('[data-record-filters]');
      if (!form) return;
      const rows = [...document.querySelectorAll('[data-record-row]')];
      const count = document.querySelector('[data-record-count]');
      const empty = document.querySelector('[data-record-empty]');
      const params = new URLSearchParams(location.search);
      for (const key of ['type', 'source', 'from', 'to']) {
        const field = form.elements.namedItem(key);
        if (field && params.has(key)) field.value = params.get(key) || '';
      }
      const apply = () => {
        const values = Object.fromEntries(new FormData(form).entries());
        let visible = 0;
        for (const row of rows) {
          const ok = (!values.type || row.dataset.type === values.type)
            && (!values.source || row.dataset.source === values.source)
            && (!values.from || (row.dataset.date && row.dataset.date >= values.from))
            && (!values.to || (row.dataset.date && row.dataset.date <= values.to));
          row.hidden = !ok;
          if (ok) visible += 1;
        }
        if (count) count.textContent = `${visible} verifiche pubbliche`;
        if (empty) empty.hidden = visible !== 0;
        const next = new URLSearchParams();
        for (const [key, value] of Object.entries(values)) if (value) next.set(key, value);
        history.replaceState(null, '', `${location.pathname}${next.size ? `?${next}` : ''}`);
      };
      form.addEventListener('input', apply);
      form.addEventListener('reset', () => setTimeout(apply));
      apply();
    })();
  </script>
</BaseLayout>
