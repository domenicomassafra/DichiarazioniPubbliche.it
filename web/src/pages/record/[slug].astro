---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SearchField from "../../components/SearchField.astro";
import ClaimRow from "../../components/ClaimRow.astro";
import { speakerSlug } from "../../lib/format";
import { loadPublicProjection } from "../../lib/projection";
import type { PublicDossier } from "../../lib/types";

export async function getStaticPaths() {
  const projection = await loadPublicProjection();
  const groups = new Map<string, PublicDossier[]>();
  for (const dossier of projection.dossiers) {
    const slug = speakerSlug(dossier);
    groups.set(slug, [...(groups.get(slug) ?? []), dossier]);
  }
  return [...groups.entries()].map(([slug, dossiers]) => ({ params: { slug }, props: { dossiers } }));
}

interface Props { dossiers: PublicDossier[] }
const { dossiers } = Astro.props;
const speaker = dossiers[0].speaker;
const canonical = `/record/person/${speakerSlug(dossiers[0])}/`;
---

<BaseLayout title={speaker.name} description={`Record pubblico verificabile di ${speaker.name}.`} canonicalPath={canonical}>
  <header class="record-header">
    <div class="shell record-header-grid">
      <div>
        <div class="eyebrow">Record pubblico</div>
        <h1 class="page-title">{speaker.name}</h1>
        {speaker.public_role && <p class="record-role">{speaker.public_role}</p>}
      </div>
      <SearchField action="/esplora/" name="q" placeholder="Cerca nel record pubblico" compact />
    </div>
  </header>
  <section class="shell page-section-tight">
    <div class="section-heading">
      <div class="section-heading-copy">
        <h2 class="section-title section-title-sm">Cronologia</h2>
        <p>Le valutazioni appartengono ai singoli fact-check, non alla persona.</p>
      </div>
    </div>
    <div class="claim-list">
      {dossiers.map((dossier) => <ClaimRow dossier={dossier} />)}
    </div>
  </section>
</BaseLayout>
