---
import BaseLayout from "../layouts/BaseLayout.astro";
import UtilityDocument from "../components/UtilityDocument.astro";
---

<BaseLayout title="Invia una segnalazione" description="Percorso di richiesta di rettifica per una dichiarazione pubblicata." canonicalPath="/segnalazioni/" privatePage>
  <UtilityDocument eyebrow="Segnalazioni" title="Hai trovato qualcosa da correggere?" lede="Una citazione inesatta, un errore nella verifica o un problema di privacy meritano una segnalazione chiara. Il modulo richiede un account verificato; l'invio è confermato soltanto se ricevi un codice di richiesta.">
    <section class="dp-utility-section" aria-labelledby="richiedi-rettifica">
      <h2 id="richiedi-rettifica">Richiedi una rettifica</h2>
      <p>Apri la pagina dal dettaglio della dichiarazione, se disponibile, oppure indica l'identificativo della verifica pubblicata. Spiega che cosa va corretto e aggiungi il riferimento alla fonte pertinente.</p>
      <form id="correction-request" class="dp-utility-form" method="post" action="/intake/corrections">
        <div id="correction-finding-group">
          <label for="correction-finding">Identificativo della verifica pubblicata</label>
          <span class="dp-utility-field-hint" id="finding-hint">Si trova nella scheda della dichiarazione interessata.</span>
          <input id="correction-finding" name="finding_id" type="text" maxlength="128" required autocomplete="off" aria-describedby="finding-hint" />
        </div>
        <p id="correction-statement-target" hidden></p>
        <input id="correction-statement" name="statement_id" type="hidden" />
        <input id="correction-version" name="version_id" type="hidden" />
        <div>
          <label for="correction-reason">Che cosa va corretto e perché?</label>
          <span class="dp-utility-field-hint" id="reason-hint">Indica il passaggio contestato e, se possibile, la fonte. Evita dati personali non necessari.</span>
          <textarea id="correction-reason" name="reason" minlength="3" maxlength="4000" required rows="5" aria-describedby="reason-hint"></textarea>
        </div>
        <div><button type="submit">Invia richiesta di rettifica</button></div>
        <p id="correction-result" role="status" aria-live="polite"></p>
      </form>
      <noscript><p>Per il modulo online è necessario JavaScript. In alternativa, puoi scrivere all'indirizzo privacy indicato qui sotto.</p></noscript>
      <p>Se il servizio di invio non è disponibile, scrivi a <a href="mailto:privacy@dichiarazionipubbliche.it">privacy@dichiarazionipubbliche.it</a> indicando l'URL della scheda e il problema. L'email non produce un codice di richiesta né sospende automaticamente la scheda.</p>
      <p><a href="/accedi/">Accedi al sito</a> · <a href="/privacy/">Informazioni privacy</a> · <a href="/metodo/#correzioni">Come funzionano le correzioni</a></p>
      <p>Conserva il codice restituito dal modulo per consultare lo stato della richiesta. Se non ricevi la conferma, l'invio non è verificato.</p>
    </section>
  </UtilityDocument>
</BaseLayout>

<script is:inline>
  const form = document.querySelector("#correction-request");
  const result = document.querySelector("#correction-result");
  const findingGroup = form?.querySelector("#correction-finding-group");
  const findingInput = form?.querySelector("#correction-finding");
  const statementTarget = form?.querySelector("#correction-statement-target");
  const statementInput = form?.querySelector("#correction-statement");
  const versionInput = form?.querySelector("#correction-version");
  const params = new URLSearchParams(window.location.search);
  const statementId = params.get("statement_id") || "";
  const versionId = params.get("version_id") || "";
  const statementMode = Boolean(statementId && versionId);
  const invalidStatementLink = Boolean(statementId || versionId) && !statementMode;
  if (statementMode && findingGroup && findingInput && statementTarget && statementInput && versionInput) {
    statementInput.value = statementId;
    versionInput.value = versionId;
    findingInput.required = false;
    findingGroup.hidden = true;
    statementTarget.hidden = false;
    statementTarget.textContent = "Dichiarazione " + statementId + " · versione " + versionId;
  }
  const submitButton = form?.querySelector("button[type=submit]");
  if (invalidStatementLink) {
    if (result) result.textContent = "Il collegamento alla dichiarazione è incompleto. Riapri il modulo dal dettaglio della dichiarazione.";
    if (submitButton) submitButton.disabled = true;
  }
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!result || !form) return;
    if (invalidStatementLink) return;
    result.textContent = "Invio in corso…";
    const button = submitButton;
    if (button) button.disabled = true;
    try {
      const session = await fetch("/account/api/session", { credentials: "same-origin", cache: "no-store" });
      if (!session.ok) {
        result.textContent = "Per inviare la richiesta devi prima accedere al sito.";
        return;
      }
      const identity = await session.json();
      if (typeof identity.csrf !== "string") throw new Error("SESSION_UNAVAILABLE");
      const values = new FormData(form);
      const reason = String(values.get("reason") || "").trim();
      const payload = statementMode ? {
        statement_id: String(values.get("statement_id") || "").trim(),
        version_id: String(values.get("version_id") || "").trim(),
        reason,
      } : {
        finding_id: String(values.get("finding_id") || "").trim(),
        reason,
      };
      const response = await fetch("/intake/corrections", {
        method: "POST", credentials: "same-origin", cache: "no-store",
        headers: { "Content-Type": "application/json", "X-CSRF-Token": identity.csrf },
        body: JSON.stringify(payload),
      });
      const data = await response.json();
      if (response.status === 202 && typeof data.request_id === "string") {
        result.replaceChildren(document.createTextNode("Richiesta ricevuta. Codice: " + data.request_id + " — "));
        const link = document.createElement("a");
        link.href = "/intake/corrections/" + encodeURIComponent(data.request_id);
        link.textContent = "Verifica lo stato";
        result.append(link);
      } else {
        result.textContent = response.status === 409
          ? "Questa scheda è già sospesa in attesa della revisione."
          : response.status === 429
            ? "Troppi invii in breve tempo. Riprova fra qualche minuto."
            : "Invio non confermato. Verifica l'accesso e riprova.";
      }
    } catch {
      result.textContent = "Servizio momentaneamente non disponibile. La richiesta non è stata confermata.";
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
