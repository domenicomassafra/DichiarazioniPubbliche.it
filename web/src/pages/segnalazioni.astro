---
import BaseLayout from "../layouts/BaseLayout.astro";
import UtilityDocument from "../components/UtilityDocument.astro";
---

<BaseLayout title="Invia una segnalazione" description="Modulo privato per richiedere la rettifica di una scheda pubblica." canonicalPath="/segnalazioni/" privatePage>
  <UtilityDocument eyebrow="Segnalazioni" title="Richiedi una rettifica" lede="Le segnalazioni sono private. Una richiesta confermata porta subito la verifica in HOLD e attiva una rianalisi automatica.">
    <section class="dp-utility-section" aria-labelledby="richiedi-rettifica">
      <h2 id="richiedi-rettifica">Rettifica o problema di privacy</h2>
      <p>Indica l'ID della verifica pubblicata e il motivo. Devi aver effettuato l'accesso con un account verificato. Non includere dati personali non necessari.</p>
      <form id="correction-request" method="post" action="/intake/corrections">
        <p><label for="correction-finding">ID della verifica pubblicata</label></p>
        <p><input id="correction-finding" name="finding_id" type="text" maxlength="128" required autocomplete="off" placeholder="finding:…" /></p>
        <p><label for="correction-reason">Cosa va corretto e perché?</label></p>
        <p><textarea id="correction-reason" name="reason" minlength="3" maxlength="4000" required rows="5" placeholder="Indica la fonte originale o il problema di privacy."></textarea></p>
        <p><button type="submit">Invia la segnalazione</button></p>
        <p id="correction-result" role="status" aria-live="polite"></p>
      </form>
      <p><a href="/accedi/">Accedi al sito</a> · <a href="/privacy/">Informazioni privacy</a></p>
      <p>Conserva l'ID ricevuto: permette di consultare online lo stato della richiesta. In caso di errore, l'invio non è confermato e puoi riprovare.</p>
    </section>
  </UtilityDocument>
</BaseLayout>

<script is:inline>
  const form = document.querySelector("#correction-request");
  const result = document.querySelector("#correction-result");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!result || !form) return;
    result.textContent = "Invio in corso…";
    const button = form.querySelector("button[type=submit]");
    if (button) button.disabled = true;
    try {
      const session = await fetch("/account/api/session", { credentials: "same-origin", cache: "no-store" });
      if (!session.ok) {
        result.textContent = "Per inviare la richiesta devi prima accedere al sito.";
        return;
      }
      const identity = await session.json();
      if (typeof identity.csrf !== "string") throw new Error("SESSION_UNAVAILABLE");
      const payload = {
        finding_id: String(new FormData(form).get("finding_id") || "").trim(),
        reason: String(new FormData(form).get("reason") || "").trim(),
      };
      const response = await fetch("/intake/corrections", {
        method: "POST", credentials: "same-origin", cache: "no-store",
        headers: { "Content-Type": "application/json", "X-CSRF-Token": identity.csrf },
        body: JSON.stringify(payload),
      });
      const data = await response.json();
      if (response.status === 202 && typeof data.request_id === "string") {
        result.replaceChildren(document.createTextNode("Rettifica in HOLD. ID: " + data.request_id + " — "));
        const link = document.createElement("a");
        link.href = "/intake/corrections/" + encodeURIComponent(data.request_id);
        link.textContent = "Verifica lo stato";
        result.append(link);
      } else {
        result.textContent = response.status === 409
          ? "Questa verifica è già sospesa in attesa della revisione."
          : response.status === 429
            ? "Troppi invii in breve tempo. Riprova fra qualche minuto."
            : "Invio non confermato. Verifica l'accesso e riprova.";
      }
    } catch {
      result.textContent = "Servizio momentaneamente non disponibile. La richiesta non è stata confermata.";
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
