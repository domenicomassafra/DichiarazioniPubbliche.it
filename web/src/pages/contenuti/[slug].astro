---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentAuditClient from "../../components/ContentAuditClient";
import { demoContentAudit } from "../../data/content-audit";
import { formatDate } from "../../lib/format";

export function getStaticPaths() {
  if (process.env.DICHIARAZIONI_PUBBLICHE_ALLOW_DEMO_PROJECTION !== "1") {
    return [];
  }
  return [{ params: { slug: demoContentAudit.slug } }];
}
---

<BaseLayout title={demoContentAudit.title} description={demoContentAudit.description}>
  <header class="shell audit-header">
    <div class="eyebrow">Analisi del contenuto</div>
    <h1 class="page-title">{demoContentAudit.title}</h1>
    <div class="audit-meta">
      <span>{demoContentAudit.source}</span><span aria-hidden="true">·</span><span>{formatDate(demoContentAudit.date)}</span><span aria-hidden="true">·</span><span>{demoContentAudit.duration}</span>
    </div>
    <p class="audit-description">{demoContentAudit.description}</p>
  </header>
  <section class="shell page-section-tight">
    <ContentAuditClient audit={demoContentAudit} client:load />
  </section>
</BaseLayout>
