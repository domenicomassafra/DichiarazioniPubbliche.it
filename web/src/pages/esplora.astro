---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExploreClient from "../components/ExploreClient";
import AtlasRoute from "../components/AtlasRoute.astro";
import "../styles/explore-349.css";
import { loadPublicProjection } from "../lib/projection";
import { loadPublishedPeopleV3 } from "../lib/publishedPeopleV3";
import { buildSearchIndexMaterial, finalizeSearchIndex } from "../lib/searchIndex";

const projection = await loadPublicProjection();
const peopleRelease = await loadPublishedPeopleV3();
const approvedIndex = await finalizeSearchIndex(buildSearchIndexMaterial(projection, peopleRelease?.people));
const hasPublicRecords = projection.dossiers.length > 0 || (projection.topics?.length ?? 0) > 0 || (projection.contents?.length ?? 0) > 0 || (peopleRelease?.people.length ?? 0) > 0;
---

<BaseLayout
  title="Esplora"
  description="Cerca dichiarazioni, persone, temi e contenuti nel record pubblico di Dichiarazioni Pubbliche."
  canonicalPath="/esplora/"
>
  <section class="shell explore-header explore-editorial-intro">
    <div>
      <p class="eyebrow">Archivio pubblico / Esplora</p>
      <h1 class="page-title">Cerca. Confronta. <em>Verifica.</em></h1>
      <p class="lede">
        {hasPublicRecords
          ? "Qui puoi cercare dichiarazioni, persone, argomenti e fonti già approvati per la pubblicazione."
          : "L'archivio pubblico è in preparazione: le ricerche saranno disponibili quando ci saranno record pubblicati."}
      </p>
      <AtlasRoute steps={[
        { label: hasPublicRecords ? "Dichiarazioni approvate" : "Archivio in preparazione" },
        { label: "Da ogni parola alla fonte", href: "/metodo/#provenienza" },
        { label: "Correzioni e versioni", href: "/correzioni/" },
      ]} />
    </div>
  </section>
  <div class="shell">
    {hasPublicRecords ? (
      <ExploreClient expectedProjectionSha256={projection.dataset_sha256} expectedIndexSha256={approvedIndex.index_sha256} client:load />
    ) : (
      <section class="dp-state launch-empty-state" data-state="empty" aria-labelledby="archivio-vuoto">
        <p class="eyebrow">Archivio in preparazione</p>
        <p class="results-count" role="status" aria-live="polite" aria-atomic="true">0 risultati pubblicati</p>
        <h2 id="archivio-vuoto" class="dp-state__title">Non ci sono ancora record pubblicati.</h2>
        <p class="dp-state__body">Non mostriamo schede di esempio o verifiche non approvate. Nel frattempo puoi leggere il metodo, conoscere il progetto e consultare le regole sulle correzioni.</p>
        <nav class="launch-empty-links" aria-label="Informazioni sul progetto">
          <a href="/metodo/">Il metodo →</a>
          <a href="/progetto/">Il progetto →</a>
          <a href="/correzioni/">Le correzioni →</a>
        </nav>
      </section>
    )}
  </div>
</BaseLayout>
