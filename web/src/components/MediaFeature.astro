---
interface Props {
  title: string;
  description: string;
  href: string;
  duration?: string;
}
const { title, description, href, duration = "32:15" } = Astro.props;
---

<article class="media-feature">
  <a class="media-poster" href={href} aria-label={`Apri ContentAudit: ${title}`}>
    <span class="media-kicker">CONTENTAUDIT</span>
    <span class="media-play" aria-hidden="true">▶</span>
    <span class="media-duration">{duration}</span>
  </a>
  <div class="media-copy">
    <div class="eyebrow">Sotto la lente</div>
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
    <a class="text-link" href={href}>Esplora l'analisi <span aria-hidden="true">→</span></a>
  </div>
</article>
