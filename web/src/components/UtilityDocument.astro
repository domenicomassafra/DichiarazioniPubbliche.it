---
import "../styles/utility-349.css";

interface Props {
  eyebrow: string;
  title: string;
  lede: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<article class="shell dp-utility-document" aria-labelledby="dp-utility-title">
  <header class="dp-utility-document__header">
    <nav class="dp-utility-document__breadcrumb" aria-label="Percorso">
      <a href="/">Archivio</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{eyebrow}</span>
    </nav>
    <h1 id="dp-utility-title">{title}</h1>
    <p class="lede">{lede}</p>
    <nav class="atlas-utility-path dp-utility-document__sibling-nav" aria-label="Altri documenti">
      <a href="/metodo/" aria-current={eyebrow === "Metodo" ? "page" : undefined}>Metodo</a>
      <a href="/correzioni/" aria-current={eyebrow === "Correzioni" ? "page" : undefined}>Correzioni</a>
      <a href="/dati/" aria-current={eyebrow === "Dati & API" ? "page" : undefined}>Dati &amp; API</a>
    </nav>
  </header>
  <aside class="dp-utility-document__rail" aria-label="Orientamento nel registro">
    {Astro.slots.has("rail") ? (
      <slot name="rail" />
    ) : (
      <nav aria-label="Documenti di fiducia">
        <h2>Documenti di fiducia</h2>
        <a href="/metodo/">Metodo</a>
        <a href="/correzioni/">Correzioni</a>
        <a href="/dati/">Dati &amp; API</a>
        <a href="/progetto/">Progetto</a>
      </nav>
    )}
  </aside>
  <div class="dp-utility-document__body">
    <slot />
  </div>
</article>
