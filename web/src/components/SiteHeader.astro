---
interface Props { studio?: boolean }
const { studio = false } = Astro.props;
const path = Astro.url.pathname;
const active = (prefix: string) => path === prefix || path.startsWith(prefix + "/");
const studioNav = [
  { href: "/studio/corpus/", label: "Corpus" },
  { href: "/studio/inbox/", label: "Inbox" },
  { href: "/studio/collections/", label: "Collections" },
  { href: "/studio/verify/", label: "Verify" },
] as const;
---

<header class:list={["site-header", studio && "studio-header"]}>
  <div class="shell header-inner">
    <a class="brand" href={studio ? "/studio/corpus/" : "/"} aria-label={studio ? "Vai al corpus di Verify Studio" : "Dichiarazioni Pubbliche, pagina iniziale"}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name">Dichiarazioni<br class="brand-name__break" />{" "}Pubbliche</span>
      {studio && <small>Verify Studio</small>}
    </a>

    {studio ? (
      <nav class="main-nav" aria-label="Verify Studio">
        {studioNav.map((item) => (
          <a
            class:list={[active(item.href.slice(0, -1)) && "is-active"]}
            aria-current={active(item.href.slice(0, -1)) ? "page" : undefined}
            href={item.href}
          >
            {item.label}
          </a>
        ))}
      </nav>
    ) : (
      <nav class="main-nav" aria-label="Navigazione principale">
        <a class:list={[active("/esplora") && "is-active"]} aria-current={active("/esplora") ? "page" : undefined} href="/esplora/">Esplora</a>
        <a class:list={[active("/persone") && "is-active"]} aria-current={active("/persone") ? "page" : undefined} href="/esplora/?tipo=person">Persone</a>
        <a class:list={[(active("/contenuti") || active("/contents") || active("/anteprima")) && "is-active"]} aria-current={active("/contenuti") || active("/contents") || active("/anteprima") ? "page" : undefined} href="/esplora/?tipo=content">Contenuti</a>
        <a class:list={[active("/metodo") && "is-active"]} aria-current={active("/metodo") ? "page" : undefined} href="/metodo/">Metodo</a>
      </nav>
    )}

    <a class="header-search" href={studio ? "/studio/corpus/" : "/esplora/"}>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <circle cx="10.8" cy="10.8" r="6.7"></circle>
        <path d="m16 16 5 5"></path>
      </svg>
      <span>{studio ? "Cerca nel corpus" : "Cerca"}</span>
    </a>
    <details class="mobile-nav">
      <summary aria-label="Menu di navigazione"><span class="mobile-nav__icon" aria-hidden="true"></span><span>Menu</span></summary>
      <nav aria-label={studio ? "Verify Studio mobile" : "Navigazione mobile"}>
        {studio ? studioNav.map((item) => (
          <a aria-current={active(item.href.slice(0, -1)) ? "page" : undefined} href={item.href}>{item.label}</a>
        )) : (
          <>
            <a aria-current={active("/esplora") ? "page" : undefined} href="/esplora/">Esplora</a>
            <a aria-current={active("/persone") ? "page" : undefined} href="/esplora/?tipo=person">Persone</a>
            <a aria-current={active("/contenuti") || active("/contents") || active("/anteprima") ? "page" : undefined} href="/esplora/?tipo=content">Contenuti</a>
            <a aria-current={active("/metodo") ? "page" : undefined} href="/metodo/">Metodo</a>
            <a aria-current={active("/progetto") ? "page" : undefined} href="/progetto/">Progetto</a>
            <a aria-current={active("/correzioni") ? "page" : undefined} href="/correzioni/">Correzioni</a>
            <a href="/esplora/" class="mobile-nav__search">Cerca nell'archivio <span aria-hidden="true">↗</span></a>
          </>
        )}
      </nav>
    </details>
  </div>
</header>

<script>
  const mobileNavigation = document.querySelector<HTMLDetailsElement>(".mobile-nav");
  mobileNavigation?.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && mobileNavigation.open) {
      mobileNavigation.open = false;
      mobileNavigation.querySelector("summary")?.focus();
    }
  });
</script>
