---
interface Props { studio?: boolean }
const { studio = false } = Astro.props;
const path = Astro.url.pathname;
const active = (prefix: string) => path === prefix || path.startsWith(prefix + "/");
const studioNav = [
  { href: "/studio/corpus/", label: "Corpus" },
  { href: "/studio/inbox/", label: "Inbox" },
  { href: "/studio/collections/", label: "Collections" },
  { href: "/studio/verify/", label: "Verify" },
] as const;
---

<header class:list={["site-header", studio && "studio-header"]}>
  {!studio && (
    <div class="shell masthead-note">
      <span>Registro pubblico delle dichiarazioni</span>
      <span>Fonti · tempo · correzioni</span>
    </div>
  )}
  <div class="shell header-inner">
    <a class="brand" href={studio ? "/studio/corpus/" : "/"} aria-label="Dichiarazioni Pubbliche home">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name">Dichiarazioni<br />Pubbliche</span>
      {studio && <small>Verify Studio</small>}
    </a>

    {studio ? (
      <nav class="main-nav" aria-label="Verify Studio">
        {studioNav.map((item) => (
          <a
            class:list={[active(item.href.slice(0, -1)) && "is-active"]}
            aria-current={active(item.href.slice(0, -1)) ? "page" : undefined}
            href={item.href}
          >
            {item.label}
          </a>
        ))}
      </nav>
    ) : (
      <nav class="main-nav" aria-label="Navigazione principale">
        <a class:list={[active("/esplora") && "is-active"]} aria-current={active("/esplora") ? "page" : undefined} href="/esplora/">Esplora</a>
        <a class:list={[active("/metodo") && "is-active"]} aria-current={active("/metodo") ? "page" : undefined} href="/metodo/">Metodo</a>
      </nav>
    )}

    <a class="header-search" href={studio ? "/studio/corpus/" : "/esplora/"}>
      <span aria-hidden="true">⌕</span>
      <span>{studio ? "Cerca nel corpus" : "Cerca"}</span>
    </a>
    <details class="mobile-nav">
      <summary>Menu</summary>
      <nav aria-label={studio ? "Verify Studio mobile" : "Navigazione mobile"}>
        {studio ? studioNav.map((item) => (
          <a aria-current={active(item.href.slice(0, -1)) ? "page" : undefined} href={item.href}>{item.label}</a>
        )) : (
          <>
            <a aria-current={active("/esplora") ? "page" : undefined} href="/esplora/">Esplora</a>
            <a aria-current={active("/metodo") ? "page" : undefined} href="/metodo/">Metodo</a>
          </>
        )}
      </nav>
    </details>
  </div>
</header>
