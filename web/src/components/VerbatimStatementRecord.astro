---
import { validateOriginalStatement, type PublicOriginalStatement } from "../lib/statementV3";
import { validatePublicStatementV3Detail } from "../lib/statementV3Api";
import { canonicalJson } from "../lib/searchIndex";

interface Props {
  statement?: PublicOriginalStatement;
  /** Pure v3 API detail only; this opt-in does not activate any public route. */
  apiDetail?: unknown;
  allowStatementV3?: boolean;
  expectedDatasetSha256?: string;
  /** Must be pinned from an independently verified approved public bundle. */
  expectedRecordSha256?: string;
}
const { statement: input, apiDetail, allowStatementV3, expectedDatasetSha256, expectedRecordSha256 } = Astro.props;
const apiMode = apiDetail !== undefined;
if (apiMode === (input !== undefined)) {
  throw new Error("PUBLIC_STATEMENT_CONSUMER_INPUT_AMBIGUOUS");
}
// A v3 API serializer excludes private review IDs: do not invent them to pass
// the source-record validator. Verify the API's separate, explicit contract.
const api = apiMode
  ? await validatePublicStatementV3Detail(apiDetail, { allowStatementV3, expectedDatasetSha256, expectedRecordSha256 })
  : null;
const record = api?.data;
// Neither old v2 dossiers nor API paraphrase cards can become original words.
const statement = record ? {
  original_text: record.original.text,
  language: record.original.language,
  speaker_name: record.person.name,
  statement_date: record.statement_date,
  source_url: record.source.url,
  source_kind: record.source.kind,
  locator: record.original.locator,
  speech_act: record.speech_act,
  summary: record.summary,
  translation: record.translation,
  finding_id: record.finding_id,
} : await (async () => {
  // Direct governed source records must not bypass the API mode's explicit
  // opt-in and independently selected record pin. A declared review ID or
  // self-reported quote hash alone is not publication authorization.
  const hash = /^[a-f0-9]{64}$/;
  if (allowStatementV3 !== true || !hash.test(expectedDatasetSha256 ?? "") ||
      !hash.test(expectedRecordSha256 ?? "")) {
    throw new Error("PUBLIC_STATEMENT_DIRECT_PIN_REQUIRED");
  }
  // Capture a stable copy before asynchronous validation: a mutable caller
  // must not swap the wording after hash verification and before SSR.
  const snapshot = structuredClone(input);
  const approved = await validateOriginalStatement(snapshot);
  const bytes = await globalThis.crypto.subtle.digest(
    "SHA-256", new TextEncoder().encode(canonicalJson(approved)),
  );
  const actual = Array.from(new Uint8Array(bytes), (byte) => byte.toString(16).padStart(2, "0")).join("");
  if (actual !== expectedRecordSha256) {
    throw new Error("PUBLIC_STATEMENT_DIRECT_RECORD_FINGERPRINT_MISMATCH");
  }
  return approved;
})();
const date = statement.statement_date;
const sourceSpan = statement.source_kind === "TIMED"
  ? `Segmento ${statement.locator.segment_id} · ${statement.locator.start_ms}–${statement.locator.end_ms} ms`
  : `Testo originale · caratteri ${statement.locator.start_char}–${statement.locator.end_char}`;
---

<article class="dp-statement-body" data-contract="public-statement-v3-opt-in" data-dataset-sha256={api?.meta.dataset_sha256 ?? expectedDatasetSha256}>
  <header class="record-header">
    <div class="eyebrow">Parole originali dalla fonte</div>
    <blockquote class="prose" lang={statement.language} cite={statement.source_url}>
      <p>{statement.original_text}</p>
    </blockquote>
    <p class="dp-statement-meta">
      <strong>{statement.speaker_name}</strong>
      <span aria-hidden="true"> · </span>
      <time datetime={date}>{date}</time>
      <span aria-hidden="true"> · </span>
      <a href={statement.source_url} rel="noreferrer">Apri la fonte originale</a>
    </p>
    <p class="dp-statement-wording-label">{sourceSpan} · lingua originale {statement.language}</p>
    {["REPORTED_QUOTE", "CRITICISM", "IRONY"].includes(statement.speech_act) && (
      <p>Queste parole sono documentate come discorso riportato, critica o ironia: non sono automaticamente una posizione sostenuta dalla persona citata.</p>
    )}
  </header>
  {statement.translation && (
    <section class="prose" aria-label="Traduzione distinta dalle parole originali">
      <h2>Traduzione ({statement.translation.language})</h2>
      <p lang={statement.translation.language}>{statement.translation.text}</p>
      <p>Traduzione revisionata e collegata alla citazione originale. Non è il testo pronunciato nella lingua sorgente.</p>
    </section>
  )}
  {statement.summary && (
    <section class="prose" aria-label="Riassunto separato dalla citazione originale">
      <h2>Riassunto</h2>
      <p>{statement.summary.text}</p>
      <p>Rappresentazione sintetica distinta dalle parole testuali.</p>
    </section>
  )}
  {statement.finding_id === null && (
    <p>Questa dichiarazione non dispone di un Finding fattuale pubblicato. La presenza del testo non equivale a una valutazione di verità.</p>
  )}
</article>
