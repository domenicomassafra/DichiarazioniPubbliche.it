---
import { validateOriginalStatement, type PublicOriginalStatement } from "../lib/statementV3";

interface Props { statement: PublicOriginalStatement }
const { statement: input } = Astro.props;
// No v2 paraphrase can enter this component and become a quote.
const statement = await validateOriginalStatement(input);
const date = statement.statement_date;
const sourceSpan = statement.source_kind === "TIMED"
  ? `Segmento ${statement.locator.segment_id} · ${statement.locator.start_ms}–${statement.locator.end_ms} ms`
  : `Testo originale · caratteri ${statement.locator.start_char}–${statement.locator.end_char}`;
---

<article class="dp-statement-body" data-contract="public-statement-v3-opt-in">
  <header class="record-header">
    <div class="eyebrow">Parole originali dalla fonte</div>
    <blockquote class="prose" lang={statement.language} cite={statement.source_url}>
      <p>{statement.original_text}</p>
    </blockquote>
    <p class="dp-statement-meta">
      <strong>{statement.speaker_name}</strong>
      <span aria-hidden="true"> · </span>
      <time datetime={date}>{date}</time>
      <span aria-hidden="true"> · </span>
      <a href={statement.source_url} rel="noreferrer">Apri la fonte originale</a>
    </p>
    <p class="dp-statement-wording-label">{sourceSpan} · lingua originale {statement.language}</p>
    {["REPORTED_QUOTE", "CRITICISM", "IRONY"].includes(statement.speech_act) && (
      <p>Queste parole sono documentate come discorso riportato, critica o ironia: non sono automaticamente una posizione sostenuta dalla persona citata.</p>
    )}
  </header>
  {statement.translation && (
    <section class="prose" aria-label="Traduzione distinta dalle parole originali">
      <h2>Traduzione ({statement.translation.language})</h2>
      <p lang={statement.translation.language}>{statement.translation.text}</p>
      <p>Traduzione revisionata e collegata alla citazione originale. Non è il testo pronunciato nella lingua sorgente.</p>
    </section>
  )}
  {statement.summary && (
    <section class="prose" aria-label="Riassunto separato dalla citazione originale">
      <h2>Riassunto</h2>
      <p>{statement.summary.text}</p>
      <p>Rappresentazione sintetica distinta dalle parole testuali.</p>
    </section>
  )}
  {statement.finding_id === null && (
    <p>Questa dichiarazione non dispone di un Finding fattuale pubblicato. La presenza del testo non equivale a una valutazione di verità.</p>
  )}
</article>
