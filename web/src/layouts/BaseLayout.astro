---
import "@fontsource-variable/newsreader";
import "@fontsource-variable/ibm-plex-sans";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  title?: string;
  description?: string;
  studio?: boolean;
  privatePage?: boolean;
  canonicalPath?: string;
  structuredData?: unknown;
}

const {
  title = "Dichiarazioni Pubbliche",
  description = "Dichiarazioni pubbliche, fonti, contesto, verifiche, cambi e correzioni in un record consultabile e versionato.",
  studio = false,
  privatePage = false,
  canonicalPath,
  structuredData
} = Astro.props;
const pageTitle = title === "Dichiarazioni Pubbliche" ? title : `${title} — Dichiarazioni Pubbliche`;
const projectionPath = process.env.DICHIARAZIONI_PUBBLICHE_PUBLIC_PROJECTION_PATH;
const usingDemoProjection = process.env.DICHIARAZIONI_PUBBLICHE_ALLOW_DEMO_PROJECTION === "1" ||
  !projectionPath || projectionPath.endsWith("demo-projection.json");
const robotsPolicy = studio || privatePage || usingDemoProjection ? "noindex,nofollow" : "index,follow";
const structuredDataJson = structuredData === undefined
  ? null
  : JSON.stringify(structuredData).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsPolicy} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f4f5f2" />
    {canonicalPath && <link rel="canonical" href={canonicalPath} />}
    {canonicalPath && <meta property="og:url" content={canonicalPath} />}
    {structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson}></script>}
    <title>{pageTitle}</title>
  </head>
  <body class:list={[studio && "is-studio"]}>
    <a class="dp-skip-link" href="#main">Vai al contenuto</a>
    {usingDemoProjection && (
      <div class="demo-banner" role="note">
        Ambiente dimostrativo: i contenuti visibili sono fittizi e servono solo a validare il prodotto.
      </div>
    )}
    <SiteHeader studio={studio} />
    <main id="main">
      <slot />
    </main>
    {!studio && (
      <footer class="site-footer shell">
        <div>
          <strong>Dichiarazioni Pubbliche</strong>
          <p>Memoria verificabile delle dichiarazioni pubbliche.</p>
        </div>
        <nav aria-label="Link footer">
          <a href="/metodo/">Metodo</a>
          <a href="/correzioni/">Correzioni</a>
          <a href="/dati/">Dati &amp; API</a>
          <a href="/progetto/">Progetto</a>
          <a href="/accedi/">Accedi</a>
          <a href="https://github.com/domenicomassafra/DichiarazioniPubbliche.it" rel="noreferrer">GitHub ↗</a>
        </nav>
      </footer>
    )}
  </body>
</html>
