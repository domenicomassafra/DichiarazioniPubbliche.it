{
  "name": "dichiarazioni-pubbliche-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:design": "node scripts/check-design-system.mjs",
    "check:search": "node --experimental-strip-types scripts/check-search-index.mjs",
    "check:quality": "node scripts/check-public-quality.mjs",
    "check:routes": "node scripts/check-route-contract.mjs",
    "check:projection-boundary": "node scripts/check-production-projection-boundary.mjs",
    "check:m4-grammar": "node scripts/check-m4-page-grammar.mjs",
    "check:trust": "node scripts/check-trust-disclosure.mjs",
    "check:corrections": "node scripts/check-correction-consistency.mjs",
    "check:browser": "node scripts/check-browser-qa.mjs",
    "check:browser:isolated": "DP_RUN_BROWSER_QA=1 node scripts/check-production-projection-boundary.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "check:rebuild": "python3 scripts/check_dp431_rebuild.py",
    "check:private-hold": "python3 scripts/check_dp431_private_hold.py"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "6.0.3"
  }
}
