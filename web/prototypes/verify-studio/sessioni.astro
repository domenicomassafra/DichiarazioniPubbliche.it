---
import BaseLayout from "../../src/layouts/BaseLayout.astro";
import { studioFixtures } from "../../src/data/studio";

const workspaces = Object.values(studioFixtures);
---

<BaseLayout title="Studio IA v3 · fixture" studio>
  <section class="studio-shell studio-page" data-density="studio">
    <div class="studio-page-title">
      <div>
        <div class="eyebrow">Prototype fixture_only</div>
        <h1>Studio IA v3</h1>
      </div>
    </div>
    <div class="session-groups">
      <section class="session-group">
        <h2>Workspace</h2>
        <div class="session-table">
          {workspaces.map((workspace) => (
            <a class="session-row" href={`/studio/${workspace.workspace}/`}>
              <strong>{workspace.title}</strong>
              <span>{workspace.dominant_task}</span>
              <span>fixture_only</span>
              <span aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
