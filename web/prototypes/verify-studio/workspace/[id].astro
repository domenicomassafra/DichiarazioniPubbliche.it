---
import BaseLayout from "../../../src/layouts/BaseLayout.astro";
import StudioWorkspaceClient from "../../../src/components/StudioWorkspaceClient";
import { studioVerifyFixture } from "../../../src/data/studio";

export function getStaticPaths() {
  return [{ params: { id: "fixture-verify" } }];
}
---

<BaseLayout title="Verify · fixture" studio>
  <div class="studio-shell" data-density="studio">
    <div class="workspace-topline">
      <strong>{studioVerifyFixture.source_title}</strong>
      <span>fixture_only</span>
    </div>
    <StudioWorkspaceClient model={studioVerifyFixture} client:load />
  </div>
</BaseLayout>
